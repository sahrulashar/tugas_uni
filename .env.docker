# ====================================================================
# Konfigurasi Environment Khusus Docker (Sistem ERP CI4)
# ====================================================================
CI_ENVIRONMENT = development

# Port lokal untuk Nginx Reverse Proxy Gateway (default: 8080)
APP_PORT = 8080

# Base URL Aplikasi ERP:
# - Saat akses lokal: 'http://localhost:8080/'
# - Saat online via Cloudflare Tunnel: ganti dengan domain tunnel Anda, contoh:
#   APP_URL = 'https://erp.domainanda.com/'
APP_URL = 'http://localhost:8080/'
app.baseURL = 'http://localhost:8080/'
app.indexPage = ''

# Token Cloudflare Tunnel (dari Cloudflare Zero Trust Dashboard -> Networks -> Tunnels)
# Kosongkan jika hanya ingin menjalankan di localhost.
# Contoh: CLOUDFLARE_TUNNEL_TOKEN = 'eyJhIjoiY2...xxxxxx'
CLOUDFLARE_TUNNEL_TOKEN = ''

# Konfigurasi Database Container (MySQL service 'db')
database.default.hostname = db
database.default.database = kas_keluar
database.default.username = root
database.default.password = root
database.default.DBDriver = MySQLi
database.default.port = 3306

# Konfigurasi Session
session.driver = 'App\Libraries\Session\FileHandler'
session.cookieName = 'ci_session'
session.expiration = 7200
session.savePath = null
