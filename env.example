#--------------------------------------------------------------------
# Environment Configuration
#--------------------------------------------------------------------

CI_ENVIRONMENT = development

#--------------------------------------------------------------------
# APP & DOCKER SETTINGS
#--------------------------------------------------------------------

# Port lokal untuk Nginx Reverse Proxy Gateway
APP_PORT = 8080

# Base URL Aplikasi ERP (ganti dengan domain tunnel saat online)
# Contoh: APP_URL = 'https://erp.domainanda.com/'
APP_URL = 'http://localhost:8080/'
app.baseURL = 'http://localhost:8080/'
app.indexPage = ''

# Token Cloudflare Tunnel (dari Cloudflare Zero Trust Dashboard)
CLOUDFLARE_TUNNEL_TOKEN = ''

#--------------------------------------------------------------------
# DATABASE
#--------------------------------------------------------------------

database.default.hostname = localhost
database.default.database = kas_keluar
database.default.username = root
database.default.password = 
database.default.DBDriver = MySQLi
database.default.port = 3306

#--------------------------------------------------------------------
# SESSION
#--------------------------------------------------------------------

